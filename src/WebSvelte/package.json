{
	"name": "websvelte",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"sideEffects": [
		"**/*.css"
	],
	"overrides": {
		"cookie": "^1.0.3"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"@types/three": "~0.186.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource/material-symbols-outlined": "^5.3.9",
		"@materialx/material-color-utilities": "^0.4.8",
		"@threlte/core": "^8.7.0",
		"@threlte/extras": "^9.23.1",
		"noph-gamepad-components": "^0.1.9",
		"noph-ui": "^0.53.2",
		"svelte-gamepad-virtual-joystick": "^1.1.1",
		"three": "~0.186.1",
		"urdf-viewer": "^0.3.2"
	}
}
